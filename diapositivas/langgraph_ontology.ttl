# =============================================================================
# ONTOLOGY METADATA
# =============================================================================

<http://ontology.langgraph-cmdp.org/2026/03>
    rdf:type owl:Ontology ;
    dc:title "LangGraph Agent to Causal MDP Ontology"@en ;
    dc:description """
        Formal ontology mapping LangGraph agent architecture to Causal Markov 
        Decision Processes (C-MDP). This ontology establishes the mathematical 
        correspondence between:
        
        - LangGraph State ↔ Belief State S in C-MDP
        - LangGraph Nodes/Tools ↔ Causal Interventions do(X)
        - Conditional Edges ↔ Policy Function π(a|s)
        - State Transitions ↔ Causal Transition Kernel P(s'|s, do(a))
        
        The formalization follows Pearl's Causal Calculus (2009), Bochman's 
        Causal Production Systems (2018), and the LangGraph framework (2024).
    """@en ;
    dc:creator "Formal Agent Systems Laboratory" ;
    dc:date "2026-03-22"^^xsd:date ;
    owl:versionInfo "1.0.0" .


# =============================================================================
# BIBLIOGRAPHIC REFERENCES
# =============================================================================

bib:Pearl2009
    rdf:type bib:AcademicReference ;
    dc:creator "Judea Pearl" ;
    dc:title "Causality: Models, Reasoning, and Inference" ;
    dc:date "2009"^^xsd:gYear ;
    dc:publisher "Cambridge University Press" ;
    bib:isbn "978-0521895606" ;
    rdfs:comment """
        Foundational text for causal calculus. Defines the do-operator:
        P(Y | do(X=x)) ≠ P(Y | X=x) in general.
        
        Key theorems used in this ontology:
        - Theorem 3.4.1 (Adjustment for Direct Causes)
        - do-calculus rules (Rule 1, 2, 3)
    """@en .

bib:Bochman2018
    rdf:type bib:AcademicReference ;
    dc:creator "Alexander Bochman" ;
    dc:title "Causal Production Systems and Nonmonotonic Reasoning" ;
    dc:date "2018"^^xsd:gYear ;
    dc:publisher "Springer" ;
    bib:doi "10.1007/978-3-319-61660-5" ;
    rdfs:comment """
        Establishes causal production inference systems. Key concept:
        Production rules P: A → B represent causal mechanisms where
        intervention on A produces B, distinct from mere correlation.
        
        Applied here: LangGraph edges as causal production rules.
    """@en .

bib:Puterman2005
    rdf:type bib:AcademicReference ;
    dc:creator "Martin L. Puterman" ;
    dc:title "Markov Decision Processes: Discrete Stochastic Dynamic Programming" ;
    dc:date "2005"^^xsd:gYear ;
    dc:publisher "Wiley-Interscience" ;
    bib:isbn "978-0471727828" ;
    rdfs:comment """
        Canonical reference for MDP theory. Provides:
        - Bellman equations: V*(s) = max_a [r(s,a) + γ Σ P(s'|s,a) V*(s')]
        - Policy iteration convergence theorems
        - Value iteration convergence theorems
    """@en .

bib:LangGraph2024
    rdf:type bib:AcademicReference ;
    dc:creator "LangChain Team" ;
    dc:title "LangGraph: A Framework for Building Stateful, Multi-Actor Applications with LLMs" ;
    dc:date "2024"^^xsd:gYear ;
    bib:url <https://langchain-ai.github.io/langgraph/> ;
    rdfs:comment """
        Framework for constructing agent workflows as directed graphs.
        Key components: StateGraph, nodes, conditional edges, state channels.
    """@en .

bib:WangDuan2024
    rdf:type bib:AcademicReference ;
    dc:creator "Jialin Wang, Zhihua Duan" ;
    dc:title "Agent AI with LangGraph: A Modular Framework for Enhancing Machine Translation Using Large Language Models" ;
    dc:date "2024"^^xsd:gYear ;
    bib:arxiv "2412.03801" ;
    rdfs:comment """
        Demonstrates modular agent design with LangGraph for translation tasks.
        Establishes IntentAgent → TranslationAgent routing patterns.
    """@en .

bib:ShiEtAl2022
    rdf:type bib:AcademicReference ;
    dc:creator "Chengchun Shi, Sheng Zhang, Wenbin Lu, Rui Song" ;
    dc:title "Statistical Inference of the Value Function for Reinforcement Learning in Infinite-Horizon Settings" ;
    dc:date "2022"^^xsd:gYear ;
    dc:publisher "Journal of the Royal Statistical Society Series B" ;
    bib:volume "84(3)" ;
    bib:pages "765-793" ;
    bib:doi "10.1111/rssb.12465" ;
    rdfs:comment """
        Statistical inference for value functions. Provides:
        - Asymptotic normality: √n(V̂ - V*) →d N(0, σ²)
        - Confidence intervals for policy evaluation
        - Sieve estimation methods for Q-functions
    """@en .


