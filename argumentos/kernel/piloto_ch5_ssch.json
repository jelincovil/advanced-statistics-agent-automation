      "book_key": "cor:ch7-traduccion",
      "kind": "formal",
      "statement": "Parte operativa: una regla δ₀ es minimax (ninguna regla mejora su peor caso) si y solo si su política copiada es maximin. Distinción explícita entre teorema de óptimos y teorema de valores (docs/08 P04).",
      "expression": {"op": "atom", "id": "trad.optimos"},
      "scope": {
        "domain": "finite",
        "statement_scope": "optima_identity",
        "carrier": "Finite_Theta_Nonempty_Finite_XA"
      },
      "assumptions": []
